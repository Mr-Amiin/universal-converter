diff --git a/styles.css b/styles.css
index 106e8925260..8be3265179b 100644
--- a/styles.css
+++ b/styles.css
@@ -166,6 +166,44 @@ color: var(--text);
 .brand span {
 white-space: nowrap;
 }
+/* Brand logo (header). Two <picture> elements are rendered by app.js
+   (renderSiteHeader); the site's existing [data-theme] switch decides which
+   one shows, so no second theme system is involved. Below 380px the
+   <picture> sources swap to the compact symbol-only logo. */
+.brand-logo {
+display: block;
+flex: 0 0 auto;
+}
+.brand-logo img {
+display: block;
+height: 40px;
+width: auto;
+max-width: none;
+}
+.brand-logo-dark {
+display: none;
+}
+[data-theme="dark"] .brand-logo-light {
+display: none;
+}
+[data-theme="dark"] .brand-logo-dark {
+display: block;
+}
+@media (min-width: 1025px) {
+.brand-logo img {
+height: 44px;
+}
+}
+@media (max-width: 600px) {
+.brand-logo img {
+height: 34px;
+}
+}
+@media (max-width: 380px) {
+.brand-logo img {
+height: 36px;
+}
+}
 .top-nav,
 .site-footer nav {
 display: flex;
@@ -1918,6 +1956,35 @@ border-top: 1px solid var(--line);
 .footer-brand {
 margin-bottom: 0.6rem;
 }
+/* Footer brand: every page ships the same footer markup (small <img> +
+   <span> text). Rather than edit every page, the shared stylesheet renders
+   the full horizontal logo through ::before, swapping to the dark logo with
+   the site's own [data-theme] switch. The legacy <img>/<span> stay in the
+   markup, hidden / visually hidden, so the link still has its text name. */
+.site-footer .footer-brand img {
+display: none;
+}
+.site-footer .footer-brand span {
+position: absolute;
+width: 1px;
+height: 1px;
+margin: -1px;
+padding: 0;
+overflow: hidden;
+clip: rect(0, 0, 0, 0);
+white-space: nowrap;
+border: 0;
+}
+.site-footer .footer-brand::before {
+content: "";
+display: block;
+width: 136px;
+height: 40px;
+background: url("logo.svg?v=2") no-repeat left center / contain;
+}
+[data-theme="dark"] .site-footer .footer-brand::before {
+background-image: url("logo-dark.svg?v=2");
+}
 .site-footer p {
 max-width: 560px;
 margin: 0;
