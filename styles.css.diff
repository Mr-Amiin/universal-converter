+/* ============================================================
+   HOMEPAGE-ONLY: left category column (category panel + its own
+   advertisement, stacked) and a dedicated 2-column tablet layout.
+   Everything here is scoped to body.homepage so it never applies
+   to SEO conversion pages (body.seo-page), which keep their
+   existing, separately-implemented responsive behavior untouched.
+   ============================================================ */
+
+/* Base stacking for the category+ad column - applies at all sizes
+   the homepage uses this wrapper, so category panel and its ad
+   always stack vertically as two separate blocks, never side by
+   side and never merged into one card. */
+body.homepage .category-column {
+display: flex;
+flex-direction: column;
+gap: 1rem;
+}
+
+/* Homepage tablet: exactly two columns from 768px to 1024px -
+   LEFT = category-column (category panel, then its own ad below),
+   RIGHT = converter. The existing right sidebar (favorite/recent/
+   history) moves to its own full-width row below this pair, rather
+   than forming a third column - matching "do not create Category |
+   Converter | Right Sidebar" as three columns. Uses body.homepage
+   as a high-specificity prefix so it wins over the unscoped
+   .tool-layout rules elsewhere in this file without needing to be
+   moved or reordered relative to them. */
+@media (min-width: 768px) and (max-width: 1024px) {
+body.homepage .tool-layout {
+display: grid;
+grid-template-columns: minmax(250px, 320px) 1fr;
+grid-template-rows: auto auto;
+gap: 1rem;
+align-items: start;
+}
+body.homepage .tool-layout .category-column {
+grid-column: 1;
+grid-row: 1;
+}
+body.homepage .tool-layout .converter-panel {
+grid-column: 2;
+grid-row: 1;
+}
+body.homepage .tool-layout .activity-panel {
+grid-column: 1 / -1;
+grid-row: 2;
+}
+}
