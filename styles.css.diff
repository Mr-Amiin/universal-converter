+/* SEO conversion pages (.hero.seo-top) must have their H1/description
+   positioned at the same left edge as the main content below (category/
+   converter/sidebar), not centered as a standalone block the way the
+   homepage's marketing hero is. The homepage's .hero-content above is
+   untouched - this only removes the centering/width-cap when the
+   .seo-top class is also present on the ancestor .hero section. */
+.seo-top .hero-content {
+width: 100%;
+max-width: none;
+margin: 0;
+}
 .hero-content .eyebrow {
 margin-bottom: 0.4rem;
 }
